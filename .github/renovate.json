{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "custom.regex"
  ],
  "automerge": false,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^vendors\\/[^/]+\\/[^/]+\\/upstream\\.yaml$/"
      ],
      "matchStrings": [
        "(?:^|\\r?\\n)repository:[ \\t]+[\"\\']?https://github\\.com/(?<depName>[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_][A-Za-z0-9_.-]*)[\"\\']?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\ntag:[ \\t]+[\"\\']?(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+)[\"\\']?[ \\t]*(?:#[^\\r\\n]*)?\\r?\\ncommit:[ \\t]+[\"\\']?(?<currentDigest>[0-9a-f]{40})[\"\\']?[ \\t]*(?:#[^\\r\\n]*)?(?:\\r?\\n|$)"
      ],
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>0|[1-9][0-9]*)\\.(?<minor>0|[1-9][0-9]*)\\.(?<patch>0|[1-9][0-9]*)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": [
        "custom.regex"
      ],
      "pinDigests": true,
      "ignoreUnstable": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "digest",
        "pinDigest"
      ],
      "enabled": false
    }
  ],
  "platformCommit": "enabled",
  "commitTrailers": [
    "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>"
  ],
  "prBodyNotes": [
    "Review the upstream changes and confirm both locked tag-to-commit mappings.",
    "For published components, review the build inputs and version-specific redistribution declaration."
  ]
}
